# API key for Gemini extraction (server-only)
NUXT_GEMINI_API_KEY=

# Frontend API base URL — required for Cloudflare Pages (frontend-only deploy).
# Point to your local backend tunnel, e.g. https://api-yourname.example.com
NUXT_PUBLIC_API_BASE=

# Set on Cloudflare Pages dashboard → Settings → Environment variables (Production)
# NUXT_PUBLIC_API_BASE=https://your-tunnel-url.example.com
