# Backend API origin — required for local dev (split apps) and for Cloudflare Pages (frontend-only deploy).
# Local dev: http://localhost:8080
# Cloudflare Pages: point to your local backend tunnel, e.g. https://api-yourname.example.com
NUXT_PUBLIC_API_BASE=

# Set on Cloudflare Pages dashboard → Settings → Environment variables (Production)
# NUXT_PUBLIC_API_BASE=https://your-tunnel-url.example.com
